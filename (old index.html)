<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DRIVE ZONE | Клуб автосимуляторов</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Задний план Liquid Glass -->
    <div class="glass-bg-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <!-- Шапка сайта -->
    <header class="header">
        <div class="header-container">
            <a href="#" class="logo" id="toTopBtn">
                <img src="svgs/Logo.svg" alt="DRIVE ZONE">
            </a>
            
            <nav class="ios-menu">
                <div class="menu-item has-popup" id="tariffsMenuItem">
                    <a href="#tariffs" class="menu-link" id="tariffsToggle">Тарифы</a>
                    <div class="dropdown-popup">
                        <a href="#autosims">Автосимуляторы</a>
                        <a href="#combos">Комбо</a>
                        <a href="#birthdays">Дни Рождения</a>
                        <a href="#corporates">Корпоративы</a>
                        <a href="#practices">Практики</a>
                        <a href="#sections">Секции</a>
                    </div>
                </div>
                <div class="menu-item">
                    <a href="#franchise" class="menu-link">Франшиза</a>
                </div>
            </nav>
        </div>
    </header>

    <main>
        <!-- Главный экран -->
        <section class="hero">
            <div class="hero-content glass-panel animate-fade-in">
                <h1 class="hero-title">DRIVE ZONE</h1>
                <p class="hero-subtitle">
                    Клуб профессиональных автосимуляторов с атмосферой настоящих гонок. 
                    Одиночные заезды, турниры, яркие корпоративы и праздники с друзьями в пространстве, куда хочется возвращаться снова и снова.
                </p>
                <div class="hero-actions">
                    <a href="#tariffs" class="btn btn-primary">Забронировать заезд</a>
                    <a href="#autosims" class="btn btn-secondary">Подробнее</a>
                </div>
            </div>
            <div class="hero-image-placeholder glass-panel">
                <div class="pulse-glow"></div>
                <span>[ Место для промо-видео или фото гонки ]</span>
            </div>
        </section>

        <!-- Секция Тарифов -->
        <section id="tariffs" class="tariffs-section">
            <h2 class="section-title" id="autosims">Автосимуляторы</h2>
            
            <div class="table-responsive glass-panel">
                <table class="tariffs-table">
                    <thead>
                        <tr>
                            <th rowspan="2" class="th-main-title">Тариф</th>
                            <th colspan="3" class="th-group-days">ПН-ЧТ</th>
                            <th colspan="3" class="th-group-days red-title">ПТ-ВС</th>
                        </tr>
                        <tr>
                            <th>30 мин</th>
                            <th>60 мин</th>
                            <th>120 мин</th>
                            <th class="red-cell-title">30 мин</th>
                            <th class="red-cell-title">60 мин</th>
                            <th class="red-cell-title">120 мин</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="tariff-info">
                                <span class="tariff-name">СПОРТКАР</span>
                                <span class="tariff-sub">Болид с открытыми колесами</span>
                            </td>
                            <td class="price-cell">590 ₽</td>
                            <td class="price-cell">790 ₽</td>
                            <td class="price-cell">1 290 ₽</td>
                            <td class="price-cell red-cell">890 ₽</td>
                            <td class="price-cell red-cell">1 090 ₽</td>
                            <td class="price-cell red-cell">1 590 ₽</td>
                        </tr>
                        <tr>
                            <td class="tariff-info">
                                <span class="tariff-name">КЛАССИКА</span>
                                <span class="tariff-sub">База для старта · Moza R5</span>
                            </td>
                            <td class="price-cell">690 ₽</td>
                            <td class="price-cell">890 ₽</td>
                            <td class="price-cell">1 390 ₽</td>
                            <td class="price-cell red-cell">990 ₽</td>
                            <td class="price-cell red-cell">1 190 ₽</td>
                            <td class="price-cell red-cell">1 690 ₽</td>
                        </tr>
                        <tr>
                            <td class="tariff-info">
                                <span class="tariff-name">ВИП</span>
                                <span class="tariff-sub">Подвижная платформа · Moza R9</span>
                            </td>
                            <td class="price-cell">890 ₽</td>
                            <td class="price-cell">1 090 ₽</td>
                            <td class="price-cell">1 490 ₽</td>
                            <td class="price-cell red-cell">1 090 ₽</td>
                            <td class="price-cell red-cell">1 390 ₽</td>
                            <td class="price-cell red-cell">1 990 ₽</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h2 class="section-title" id="combos">Комбо-наборы</h2>
            <div class="tariffs-grid double">
                <div class="tariff-card glass-panel combo-card">
                    <h3>Комбо «Дуэль»</h3>
                    <p class="price">4 500 ₽ <span>/час</span></p>
                    <p class="desc">Два синхронизированных симулятора для заезда один на один с другом.</p>
                </div>
                <div class="tariff-card glass-panel combo-card">
                    <h3>Комбо «Тройной форсаж»</h3>
                    <p class="price">6 500 ₽ <span>/час</span></p>
                    <p class="desc">Три симулятора на одной трассе. Устройте полноценный мини-чемпионат.</p>
                </div>
            </div>
        </section>
        <!-- Блок: Дни Рождения -->
        <section id="birthdays" class="large-info-section">
            <div class="large-info-container">
                <div class="large-info-content glass-panel">
                    <h2 class="block-main-title">Дни Рождения</h2>
                    <p class="block-main-desc">
                        Аренда всего клуба, праздничная атмосфера, мини-турнир с награждением для именинника и его друзей. 
                        Мы берем на себя всю организацию: от настройки симуляторов до ведения турнирной таблицы. 
                        Эмоции и адреналин, которые запомнятся гостям надолго.
                    </p>
                    <a href="#booking" class="btn btn-secondary">Узнать условия</a>
                </div>
                <!-- Контейнер для фото (картинку нужно положить в твой репозиторий, например в папку images) -->
                <div class="large-info-image glass-panel">
                    <img src="images/birthday.jpg" alt="Дни Рождения в DRIVE ZONE" onerror="this.style.display='none'">
                    <span class="image-stub">[ Фото: День Рождения в клубе ]</span>
                </div>
            </div>
        </section>

        <!-- Блок: Корпоративы -->
        <section id="corporates" class="large-info-section reverse">
            <div class="large-info-container">
                <div class="large-info-content glass-panel">
                    <h2 class="block-main-title">Корпоративы</h2>
                    <p class="block-main-desc">
                        Тимбилдинг на максимальной скорости. Командные гонки на выносливость, полноценная фуршетная зона, 
                        профессиональный ведущий-комментатор и трансляция заездов на больших экранах. 
                        Сплотите команду в условиях бескомпромиссной борьбы за сотые доли секунды на лучших трассах мира.
                    </p>
                    <a href="#booking" class="btn btn-secondary">Оставить заявку</a>
                </div>
                <div class="large-info-image glass-panel">
                    <img src="images/corporate.jpg" alt="Корпоративы в DRIVE ZONE" onerror="this.style.display='none'">
                    <span class="image-stub">[ Фото: Гоночный Тимбилдинг ]</span>
                </div>
            </div>
        </section>

        <!-- Блок: Практики -->
        <section id="practices" class="large-info-section">
            <div class="large-info-container">
                <div class="large-info-content glass-panel">
                    <h2 class="block-main-title">Практики</h2>
                    <p class="block-main-desc">
                        Индивидуальные тренировки с детальным разбором телеметрии. Профессиональные инструкторы помогут 
                        найти правильные траектории, точки торможения и объяснят физику поведения машины на треке. 
                        Идеальный формат для тех, кто хочет существенно улучшить свое время круга.
                    </p>
                    <a href="#booking" class="btn btn-secondary">Записаться к тренеру</a>
                </div>
                <div class="large-info-image glass-panel">
                    <img src="images/practice.jpg" alt="Практики в DRIVE ZONE" onerror="this.style.display='none'">
                    <span class="image-stub">[ Фото: Тренировочный процесс ]</span>
                </div>
            </div>
        </section>

        <!-- Блок: Секции -->
        <section id="sections" class="large-info-section reverse">
            <div class="large-info-container">
                <div class="large-info-content glass-panel">
                    <h2 class="block-main-title">Секции</h2>
                    <p class="block-main-desc">
                        Регулярная гоночная академия для детей и взрослых. Погружение в мир профессионального симрейсинга, 
                        изучение гоночной инженерии, тактики ведения затяжных гонок и подготовка к участию в крупных виртуальных 
                        и реальных автоспортивных чемпионатах. Начните свой путь в большой автоспорт.
                    </p>
                    <a href="#booking" class="btn btn-primary">Подать заявку в академию</a>
                </div>
                <div class="large-info-image glass-panel">
                    <img src="images/section.jpg" alt="Секции в DRIVE ZONE" onerror="this.style.display='none'">
                    <span class="image-stub">[ Фото: Академия симрейсинга ]</span>
                </div>
            </div>
        </section>
    </main>

    <!-- Скрипты взаимодействия -->
    <script>
        // Скролл вверх при клике на лого
        document.getElementById('toTopBtn').addEventListener('click', function(e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Логика клика по меню «Тарифы» для мобильных устройств
        const tariffsToggle = document.getElementById('tariffsToggle');
        const tariffsMenuItem = document.getElementById('tariffsMenuItem');

        tariffsToggle.addEventListener('click', function(e) {
            if (window.innerWidth <= 768) {
                e.preventDefault(); // Запрещаем мгновенный переход по якорю
                tariffsMenuItem.classList.toggle('active-click');
            }
        });

        // Закрытие попапа при клике в любое другое место экрана
        document.addEventListener('click', function(e) {
            if (!tariffsMenuItem.contains(e.target)) {
                tariffsMenuItem.classList.remove('active-click');
            }
        });
    </script>
</body>
</html>
